#!/bin/sh
# Digitable Session — окно Digit.
#
# Открывает агента Digit в терминале с фиксированными именем и классом окна
# (WM_CLASS = digit, Digit). По этой паре cwmrc ловит окно правилом
#   autogroup 0 "digit,Digit"
# и держит его видимым на всех рабочих столах.
#
# Скрипт идемпотентен: если окно уже есть и в системе стоит xdotool — оно
# поднимается, а второй экземпляр не запускается.

set -u

TERMINAL="@@TERMINAL@@"

# Геометрия колонки Digit. Меняется переменными окружения — например, в
# ~/.config/digitwm/autostart.
COLUMNS_WIDTH="${DIGITWM_DIGIT_COLUMNS:-88}"
COLUMNS_HEIGHT="${DIGITWM_DIGIT_LINES:-46}"
POSITION_X="${DIGITWM_DIGIT_X:-0}"
POSITION_Y="${DIGITWM_DIGIT_Y:-0}"

# --- Уже открыт? ------------------------------------------------------------
if command -v xdotool >/dev/null 2>&1; then
    existing=$(xdotool search --class '^Digit$' 2>/dev/null | head -n 1)
    if [ -n "$existing" ]; then
        xdotool windowactivate "$existing" 2>/dev/null && exit 0
    fi
fi

# --- Есть ли сам Digit ------------------------------------------------------
# Если агента нет, открываем терминал с инструкцией, а не молча ничего.
# Установщик сессии не скачивает и не запускает чужой скрипт из сети за вас:
# `curl | bash` — это решение пользователя, а не побочный эффект входа в
# систему. Команда напечатана, выполнить её — одна строка.
MISSING_MESSAGE='printf "\n  Digit не установлен.\n\n  Поставить:\n    curl -fsSL https://raw.githubusercontent.com/digitable-lol/digit/main/scripts/install.sh | bash\n    digit setup\n\n  Или переставьте сессию с флагом:\n    session/install.sh --with-digit\n\n  Окно закроется по Enter.\n\n"; read -r _'

if command -v digit >/dev/null 2>&1; then
    # The complete living-form pack ships inside Digit, so selection is
    # offline and idempotent. Digit owns state-driven form/animation changes;
    # digitwm only gives the pet a permanent home in the agent window.
    # Only a genuinely unset slug is first-run state. `digit pets off` keeps
    # the slug, which is how an intentional disable survives the next login.
    case "${DIGITWM_DIGITMORF:-auto}" in
        0 | false | no | off) ;;
        *)
            if digit pets doctor 2>/dev/null \
                | grep -Eq 'display\.pet\.slug:[[:space:]]+\(unset\)[[:space:]]*$'; then
                digit pets install digitmorf --select >/dev/null 2>&1 || :
            fi
            ;;
    esac
    set -- digit
else
    set -- sh -c "$MISSING_MESSAGE"
fi

# --- Запуск в терминале -----------------------------------------------------
case "$(basename -- "$TERMINAL")" in
    alacritty)
        exec "$TERMINAL" \
            --class digit,Digit \
            --title "Digit" \
            -o "window.position.x=$POSITION_X" \
            -o "window.position.y=$POSITION_Y" \
            -o "window.dimensions.columns=$COLUMNS_WIDTH" \
            -o "window.dimensions.lines=$COLUMNS_HEIGHT" \
            -e "$@"
        ;;
    kitty)
        exec "$TERMINAL" --name digit --class Digit --title "Digit" "$@"
        ;;
    *)
        # xterm и совместимые: -name задаёт res_name, -class задаёт res_class.
        exec "$TERMINAL" -name digit -class Digit -title "Digit" -e "$@"
        ;;
esac
