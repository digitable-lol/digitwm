#!/bin/sh
# Digitable Session — ваш автозапуск.
#
# Этот файл создаётся один раз и больше никогда не переписывается: ни
# обновлением сессии, ни повторным запуском install.sh. Всё, что вы сюда
# добавите, останется.
#
# Запускается из digitwm-session ДО оконного менеджера и в фоне. Значит:
# каждая долгоживущая программа должна уходить в фон сама (&), иначе она
# задержит появление рабочего стола.
#
# Здесь ЗАПУСКАЮТ программы. Переменные окружения задают в соседнем файле
# ~/.config/digitwm/env: этот файл — отдельный фоновый потомок сессии, и
# экспорт отсюда не попадает ни в окно Digit, ни в оконный менеджер. Раньше
# документация обещала обратное; обещание было ложным, и его убрали.

# Раскладка клавиатуры и переключение — X11 не угадывает её за вас.
# command -v setxkbmap >/dev/null 2>&1 && \
#   setxkbmap -layout us,ru -option grp:alt_shift_toggle

# Композитор. Оконный менеджер им не является и анимаций не рисует; если
# нужны прозрачность и тени — запускайте picom отдельно и верните
# opacity = 0.9 в ~/.config/digitwm/alacritty.toml.
# command -v picom >/dev/null 2>&1 && picom --daemon

# Обои вместо однотонного фона.
# command -v feh >/dev/null 2>&1 && feh --bg-fill "$HOME/.local/share/digitwm/wallpaper.jpg"

# Панель. Своей у digitwm нет и не планируется — решение с числами лежит в
# doc/panel.ru.md. Внешняя выбрана та же: polybar. Её ставит установщик
# сессии, конфигурация пришла вместе с сессией и покрашена вашей палитрой;
# лента отдаёт ей полосу сама, окна под неё не уезжают.
#
# Сама панель при входе НЕ поднимается: Mod4+Shift+b запускает её, когда она
# нужна, и сворачивает, когда нет. Раскомментируйте строку, если панель нужна
# вам с самого входа.
# command -v digitwm-panel >/dev/null 2>&1 && digitwm-panel &

# Гашение экрана и энергосбережение.
# command -v xset >/dev/null 2>&1 && xset s 600 dpms 900 1200 1800

# Агент сети, буфер обмена, уведомления — что нужно именно вам.
# command -v nm-applet >/dev/null 2>&1 && nm-applet &
# command -v dunst >/dev/null 2>&1 && dunst &

# Digit запускается отдельно, из digitwm-session. Отключить его, изменить
# геометрию окна или отказаться от разовой подготовки Digitmorf — строкой
# DIGITWM_NO_DIGIT=1 (или DIGITWM_DIGITMORF=off) в ~/.config/digitwm/env,
# а не здесь.
