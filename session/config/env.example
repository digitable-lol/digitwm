# Digitable Session — ваши переменные окружения.
#
# Этот файл создаётся один раз и больше никогда не переписывается: ни
# обновлением сессии, ни повторным запуском install.sh. Всё, что вы сюда
# добавите, останется.
#
# Читается из digitwm-session ДО автозапуска и ДО окна Digit, поэтому
# переменные видят оба. В autostart их писать бесполезно: autostart —
# отдельный фоновый потомок, а digitwm-digit — его сосед, и экспорт из
# одного в другого не попадает.
#
# Файл подключается через `set -a`, то есть присвоенное здесь экспортируется
# само: писать `export` не нужно. Это НЕ скрипт запуска — программы отсюда не
# запускают, для этого есть autostart. Перед подключением файл проверяется
# `sh -n`: синтаксическая ошибка не убьёт вход, но и переменные тогда не
# применятся, о чём будет строка в ~/.local/state/digitwm/session.log.

# --- Digit ------------------------------------------------------------------

# Не запускать Digit при входе вовсе.
# DIGITWM_NO_DIGIT=1

# Не выбирать Digitmorf при первом запуске окна Digit. Разовая подготовка и
# так не трогает уже выбранного питомца и не включает выключенный показ.
# DIGITWM_DIGITMORF=off

# Геометрия окна Digit: колонки, строки и координаты левого верхнего угла.
# Работает на alacritty; kitty и xterm берут размер из своей конфигурации.
# DIGITWM_DIGIT_COLUMNS=88
# DIGITWM_DIGIT_LINES=46
# DIGITWM_DIGIT_X=0
# DIGITWM_DIGIT_Y=0

# --- Рабочая сессия tmux (digitwm-dev-session, алиас dev) -------------------

# DIGITWM_DEV_SESSION=work
# DIGITWM_PROJECTS_DIR="$HOME/projects"
# DIGITWM_DOWNLOADS_DIR="$HOME/downloads"

# --- Что сессия задаёт сама -------------------------------------------------
#
# DIGITWM_SESSION=1                  признак «мы внутри сессии digitwm»;
#                                    по нему же digitwm-session отказывается
#                                    запуститься внутри самого себя.
# DIGITWM_PALETTE_BACKGROUND=#…      цвет фона палитры; его берут xsetroot для
#                                    рабочего стола и digitwm-lock для экрана
#                                    блокировки. Переопределите здесь, если
#                                    хотите другой фон, — строка ниже действует
#                                    и на фон, и на замок.
# DIGITWM_PALETTE_BACKGROUND=#101010
