" ============================================================================
" Digitable Session — Vim.
"
" Раскладка и повадки взяты из github.com/the-homeless-god/dotfiles,
" цвета — из генератора тем Digitable Workbench
" (products/workbench/scripts/targets/vim.mjs). Своей цветовой схемы здесь
" нет и быть не должно: colorscheme приезжает файлом в ~/.vim/colors.
"
" Файл ставится как ~/.config/digitwm/vimrc и подключается из ~/.vimrc одной
" строкой в помеченном блоке. Никакие настройки пользователя он не удаляет:
" всё, что было в ~/.vimrc, продолжает работать до и после блока.
"
" Отличия от исходных dotfiles — сознательные, каждое подписано словом
" ОТЛИЧИЕ. Их четырнадцать; все перечислены в session/docs/KEYS.md.
" ============================================================================

if exists('g:digitable_session_vimrc')
  finish
endif
let g:digitable_session_vimrc = 1

set nocompatible

" ----------------------------------------------------------------------------
" Тир плагинов
" ----------------------------------------------------------------------------
" Лёгкий тир (по умолчанию) не требует ни компилятора, ни node, ни python —
" ставится везде, где есть git. Тяжёлый включается строкой
"   let g:digitable_heavy = 1
" в ~/.vimrc ДО подключения этого файла; в нём coc.nvim (нужен node),
" prettier, vim-go, markdown-preview и ale. ОТЛИЧИЕ 1: в dotfiles тяжёлые
" плагины стоят безусловно, включая YouCompleteMe с ./install.py — на чистой
" машине это превращает «поставил и работает» в «поставил и полчаса ждёшь,
" а потом ошибка сборки».
let g:digitable_heavy = get(g:, 'digitable_heavy', 0)

" Показывать which-key при старте — привычка из dotfiles («Показываем хоткеи
" при старте»). Отключается: let g:digitable_show_keys_on_start = 0
let g:digitable_show_keys_on_start = get(g:, 'digitable_show_keys_on_start', 1)

let s:is_nvim = has('nvim')
if s:is_nvim
  let s:plug_file = stdpath('data') . '/site/autoload/plug.vim'
  let s:plug_dir = stdpath('data') . '/plugged'
else
  let s:plug_file = expand('~/.vim/autoload/plug.vim')
  let s:plug_dir = expand('~/.vim/plugged')
endif

" ОТЛИЧИЕ 2: plug#begin вызывается только если vim-plug реально установлен.
" В dotfiles его отсутствие даёт стену ошибок при каждом старте vim.
if filereadable(s:plug_file)
  call plug#begin(s:plug_dir)

