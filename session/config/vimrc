" ----------------------------------------------------------------------------
" Умные обёртки: работают и с LSP, и без него
" ----------------------------------------------------------------------------
" ОТЛИЧИЕ 8: в dotfiles gd, K, \f и контекстное меню жёстко зовут CoC. Без
" установленного CoC они падают. Здесь каждая функция сначала спрашивает,
" есть ли CoC, и если нет — делает то же самое встроенными средствами.

function! s:HasCoc() abort
  return exists('*CocAction') && get(g:, 'coc_service_initialized', 0)
endfunction

function! DigitableHover() abort
  if s:HasCoc() && CocAction('hasProvider', 'hover')
    call CocActionAsync('doHover')
  else
    call feedkeys('K', 'in')
  endif
endfunction

function! DigitableGoto(kind) abort
  if s:HasCoc()
    call CocActionAsync(a:kind)
  elseif a:kind ==# 'jumpDefinition'
    normal! gd
  else
    normal! gD
  endif
endfunction

function! DigitableFormat() abort
  if s:HasCoc()
    call CocAction('format')
  elseif exists(':Prettier') == 2
    Prettier
  else
    let l:view = winsaveview()
    normal! gg=G
    call winrestview(l:view)
  endif
endfunction

function! DigitableRename() abort
  if s:HasCoc()
    call CocActionAsync('rename')
  else
    echohl WarningMsg | echo 'Переименование символа требует LSP: let g:digitable_heavy = 1' | echohl None
  endif
endfunction

" Терминал: floaterm, если есть, иначе встроенный :terminal.
function! DigitableTerm(cmd) abort
  if exists(':FloatermNew') == 2
    execute 'FloatermNew --width=0.8 --height=0.8 ' . a:cmd
  elseif has('terminal') || s:is_nvim
    execute 'botright terminal ' . a:cmd
  else
    execute '!' . a:cmd
  endif
endfunction

