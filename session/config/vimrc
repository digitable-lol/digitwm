" ----------------------------------------------------------------------------
" Контекстное меню — «лучшая фича из лучших», сохранена целиком
" ----------------------------------------------------------------------------
function! s:DigitableContextMenu() abort
  if &buftype !=# '' || !buflisted(bufnr('%'))
    return
  endif
  if !has('popupwin')
    echohl WarningMsg | echo 'Контекстное меню требует vim с +popupwin' | echohl None
    return
  endif
  let l:menu = []
  call add(l:menu, ['Перейти к определению (gd)', "call DigitableGoto('jumpDefinition')"])
  call add(l:menu, ['Перейти к типу (gy)', "call DigitableGoto('jumpTypeDefinition')"])
  call add(l:menu, ['Перейти к реализации (gi)', "call DigitableGoto('jumpImplementation')"])
  call add(l:menu, ['Показать ссылки (gr)', "call DigitableGoto('jumpReferences')"])
  call add(l:menu, ['Показать документацию (K)', 'call DigitableHover()'])
  call add(l:menu, ['-', ''])
  call add(l:menu, ['Открыть справа', 'vsplit'])
  call add(l:menu, ['Открыть снизу', 'split'])
  call add(l:menu, ['Открыть в новой вкладке', 'tab split'])
  call add(l:menu, ['-', ''])
  call add(l:menu, ['Переименовать символ', 'call DigitableRename()'])
  call add(l:menu, ['Форматировать', 'call DigitableFormat()'])
  let s:context_menu = l:menu
  call popup_menu(map(copy(l:menu), 'v:val[0]'), #{
        \ line: 'cursor+1',
        \ col: 'cursor',
        \ callback: function('s:DigitableContextChoice')
        \ })
endfunction

function! s:DigitableContextChoice(id, choice) abort
  if a:choice <= 0 || s:context_menu[a:choice - 1][0] ==# '-'
    return
  endif
  try
    execute s:context_menu[a:choice - 1][1]
  catch
    echohl ErrorMsg | echo 'Ошибка при выполнении команды: ' . v:exception | echohl None
  endtry
endfunction

nnoremap <silent> <RightMouse>  :call <SID>DigitableContextMenu()<CR>
vnoremap <silent> <RightMouse>  :<C-u>call <SID>DigitableContextMenu()<CR>
nnoremap <silent> <Leader>m     :call <SID>DigitableContextMenu()<CR>
vnoremap <silent> <Leader>m     :<C-u>call <SID>DigitableContextMenu()<CR>

" ----------------------------------------------------------------------------
" Автокоманды
" ----------------------------------------------------------------------------
augroup digitable_session
  autocmd!
  " Терминал открывается сразу в режиме вставки — как в dotfiles.
  if s:is_nvim
    autocmd TermOpen * startinsert
  else
    autocmd TerminalOpen * startinsert
  endif
  " Подсветка при копировании.
  if exists('##TextYankPost')
    autocmd TextYankPost * silent! call DigitableFlashYank()
  endif
  " netrw: q и x не закрывают проводник — привычка из dotfiles.
  autocmd FileType netrw nnoremap <buffer> <silent> q :echo "Закрыть проводник: :Nclose"<CR>
  autocmd FileType netrw nnoremap <buffer> <silent> x :echo "Закрыть проводник: :Nclose"<CR>
  autocmd FileType netrw setlocal bufhidden=hide
  if g:digitable_show_keys_on_start
    autocmd VimEnter * call DigitableShowKeys()
  endif
augroup END

function! DigitableFlashYank() abort
  if s:is_nvim
    lua vim.highlight.on_yank({higroup = 'IncSearch', timeout = 700})
  endif
endfunction

function! DigitableShowKeys() abort
  if exists(':WhichKey') == 2
    call which_key#register('\', 'g:which_key_map')
    WhichKey '\'
  endif
endfunction

if exists(':WhichKey') == 2
  call which_key#register('\', 'g:which_key_map')
  nnoremap <silent> <Leader> :<C-u>WhichKey '\'<CR>
  vnoremap <silent> <Leader> :<C-u>WhichKeyVisual '\'<CR>
endif

" ОТЛИЧИЕ 12: в dotfiles which_key#register вызывается четыре раза и
" маппинг лидера ставится трижды — здесь один раз, поведение то же.
" ОТЛИЧИЕ 13: убран autocmd VimEnter * silent! — команда без аргументов
" ничего не делала и мешала читать файл.
" ОТЛИЧИЕ 14: set number! (переключатель) заменён на set number — в dotfiles
" он выключал нумерацию, которую строкой выше включили.
