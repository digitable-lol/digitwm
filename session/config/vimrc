    Plug 'fatih/vim-go', {'do': ':GoUpdateBinaries'}
    Plug 'liuchengxu/vista.vim'
    Plug 'iamcco/markdown-preview.nvim', {'do': 'cd app && npx --yes yarn install'}
  endif

  call plug#end()
