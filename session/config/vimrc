  Plug 'junegunn/fzf'
  Plug 'junegunn/fzf.vim'
  Plug 'jremmen/vim-ripgrep'
  Plug 'ptzz/lf.vim'
  Plug 'voldikss/vim-floaterm'
  Plug 'jeetsukumaran/vim-buffergator'
  Plug 'rbgrouleff/bclose.vim'

  " --- git
  Plug 'tpope/vim-fugitive'
