
category "Ribbon layout"

  object "Canvas scroll"
    viewport-height is number
    window-top is number
    window-height is number
    offset is number
    gap is number
    canvas-height is number
    viewport-slack is number
    top-slack is number
    bottom-slack is number
    scroll-limit is number
    overhang is number
    limit-less-top is number
    limit-less-bottom is number

  utility stack-offset
    accepts "Canvas scroll"
    returns number
    starts with 0


    // Where the viewport wants to sit.  The seven conditions do not
    // overlap, so the order of the rules in this part decides nothing.

    rule "Window taller than the viewport: the viewport takes its top edge"
      if viewport-slack is at most 0
      then result equals 100 percent of field window-top

    rule "Window ran off above"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is less than 100 percent of field gap
      then result equals 100 percent of field window-top

    rule "Window ran off above: keep a margin"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is less than 100 percent of field gap
      then add -100 percent of field gap

    rule "Window ran off below"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is at least 100 percent of field gap
      and bottom-slack is less than 100 percent of field gap
      then result equals 100 percent of field overhang

    rule "Window ran off below: keep a margin"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is at least 100 percent of field gap
      and bottom-slack is less than 100 percent of field gap
      then add 100 percent of field gap

    rule "Window fully visible: the viewport stays"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is at least 100 percent of field gap
      and bottom-slack is at least 100 percent of field gap
      then result equals 100 percent of field offset


    // The same three cases when there is no room for a margin: the window
    // is shorter than the viewport, but by less than a gap.

    rule "No room for a margin, window ran off above"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is less than 0
      then result equals 100 percent of field window-top

    rule "No room for a margin, window ran off below"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is at least 0
      and bottom-slack is less than 0
      then result equals 100 percent of field overhang

    rule "No room for a margin, window fully visible"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is at least 0
      and bottom-slack is at least 0
      then result equals 100 percent of field offset


    // The viewport never leaves the ends of the canvas.  These conditions
    // repeat the conditions of the branches, because a rule cannot see the
    // result computed so far and has to work out from the input which
    // branch has run.

    rule "Tall window sits past the scroll limit"
      if viewport-slack is at most 0
      and window-top is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "Window above sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is less than 100 percent of field gap
      and limit-less-top is less than -100 percent of field gap
      then result equals 100 percent of field scroll-limit

    rule "Window below sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is at least 100 percent of field gap
      and bottom-slack is less than 100 percent of field gap
      and limit-less-bottom is less than 100 percent of field gap
      then result equals 100 percent of field scroll-limit

    rule "Previous offset sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is at least 100 percent of field gap
      and bottom-slack is at least 100 percent of field gap
      and offset is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "No margin, window above past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is less than 0
      and window-top is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "No margin, window below past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is at least 0
      and bottom-slack is less than 0
      and limit-less-bottom is less than 0
      then result equals 100 percent of field scroll-limit

    rule "No margin, previous offset past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and top-slack is at least 0
      and bottom-slack is at least 0
      and offset is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "Margin above runs into the top of the canvas"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and top-slack is less than 100 percent of field gap
      and window-top is less than 100 percent of field gap
      then result equals 0

    rule "Canvas no taller than the viewport: nothing to scroll"
      if scroll-limit is at most 0
      then result equals 0

    property "Offset is not negative"
      result is at least 0

    property "Offset is no larger than the canvas"
      result is at most 100 percent of field canvas-height

    property "Viewport never starts below the window"
      result is at most 100 percent of field window-top

    example "Empty canvas"
      given viewport-height equals 800
      given window-top equals 0
      given window-height equals 0
      given offset equals 0
      given gap equals 8
      given canvas-height equals 0
      given viewport-slack equals 800
      given top-slack equals 0
      given bottom-slack equals 800
      given scroll-limit equals -800
      given overhang equals -800
      given limit-less-top equals -800
      given limit-less-bottom equals 0
      expected result equals 0

    example "One window filling the viewport"
      given viewport-height equals 800
      given window-top equals 0
      given window-height equals 800
      given offset equals 0
      given gap equals 8
      given canvas-height equals 800
      given viewport-slack equals 0
      given top-slack equals 0
      given bottom-slack equals 0
      given scroll-limit equals 0
      given overhang equals 0
      given limit-less-top equals 0
      given limit-less-bottom equals 0
      expected result equals 0

    example "Focus on the first window of a tall stack"
      given viewport-height equals 800
      given window-top equals 0
      given window-height equals 60
      given offset equals 500
      given gap equals 8
      given canvas-height equals 1352
      given viewport-slack equals 740
      given top-slack equals -500
      given bottom-slack equals 1240
      given scroll-limit equals 552
      given overhang equals -740
      given limit-less-top equals 552
      given limit-less-bottom equals 1292
      expected result equals 0

    example "Twentieth window of the stack: the very 552"
      given viewport-height equals 800
      given window-top equals 1292
      given window-height equals 60
      given offset equals 0
      given gap equals 8
      given canvas-height equals 1352
      given viewport-slack equals 740
      given top-slack equals 1292
      given bottom-slack equals -552
      given scroll-limit equals 552
      given overhang equals 552
      given limit-less-top equals -740
      given limit-less-bottom equals 0
      expected result equals 552

    example "Window taller than the viewport"
      given viewport-height equals 800
      given window-top equals 1292
      given window-height equals 900
      given offset equals 0
      given gap equals 8
      given canvas-height equals 2192
      given viewport-slack equals -100
      given top-slack equals 1292
      given bottom-slack equals -1392
      given scroll-limit equals 1392
      given overhang equals 1392
      given limit-less-top equals 100
      given limit-less-bottom equals 0
      expected result equals 1292

    example "Window fully visible: the viewport stays"
      given viewport-height equals 800
      given window-top equals 100
      given window-height equals 200
      given offset equals 50
      given gap equals 8
      given canvas-height equals 1352
      given viewport-slack equals 600
      given top-slack equals 50
      given bottom-slack equals 550
      given scroll-limit equals 552
      given overhang equals -500
      given limit-less-top equals 452
      given limit-less-bottom equals 1052
      expected result equals 50

    example "Window shorter than the viewport by less than a gap"
      given viewport-height equals 800
      given window-top equals 1000
      given window-height equals 796
      given offset equals 0
      given gap equals 8
      given canvas-height equals 2000
      given viewport-slack equals 4
      given top-slack equals 1000
      given bottom-slack equals -996
      given scroll-limit equals 1200
      given overhang equals 996
      given limit-less-top equals 200
      given limit-less-bottom equals 204
      expected result equals 996

    example "Stale offset after a window closed"
      given viewport-height equals 500
      given window-top equals 600
      given window-height equals 100
      given offset equals 950
      given gap equals 8
      given canvas-height equals 1000
      given viewport-slack equals 400
      given top-slack equals -350
      given bottom-slack equals 750
      given scroll-limit equals 500
      given overhang equals 200
      given limit-less-top equals -100
      given limit-less-bottom equals 300
      expected result equals 500
