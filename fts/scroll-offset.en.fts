
category "Ribbon layout"

  object "Ribbon scroll"
    viewport-width is number
    column-left is number
    column-width is number
    offset is number
    gap is number
    ribbon-length is number
    viewport-slack is number
    left-slack is number
    right-slack is number
    scroll-limit is number
    overhang is number
    limit-less-left is number
    limit-less-right is number

  utility scroll-offset
    accepts "Ribbon scroll"
    returns number
    starts with 0


    // Where the viewport wants to sit.  The seven conditions do not
    // overlap, so the order of the rules in this part decides nothing.

    rule "Column wider than the viewport: the viewport takes its left edge"
      if viewport-slack is at most 0
      then result equals 100 percent of field column-left

    rule "Column ran off to the left"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is less than 100 percent of field gap
      then result equals 100 percent of field column-left

    rule "Column ran off to the left: keep a margin"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is less than 100 percent of field gap
      then add -100 percent of field gap

    rule "Column ran off to the right"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is at least 100 percent of field gap
      and right-slack is less than 100 percent of field gap
      then result equals 100 percent of field overhang

    rule "Column ran off to the right: keep a margin"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is at least 100 percent of field gap
      and right-slack is less than 100 percent of field gap
      then add 100 percent of field gap

    rule "Column fully visible: the viewport stays"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is at least 100 percent of field gap
      and right-slack is at least 100 percent of field gap
      then result equals 100 percent of field offset


    // The same three cases when there is no room for a margin: the column
    // is narrower than the viewport, but by less than a gap.

    rule "No room for a margin, column ran off to the left"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is less than 0
      then result equals 100 percent of field column-left

    rule "No room for a margin, column ran off to the right"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is at least 0
      and right-slack is less than 0
      then result equals 100 percent of field overhang

    rule "No room for a margin, column fully visible"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is at least 0
      and right-slack is at least 0
      then result equals 100 percent of field offset


    // The viewport never leaves the ends of the ribbon.  These conditions
    // repeat the conditions of the branches, because a rule cannot see the
    // result computed so far and has to work out from the input which
    // branch has run.

    rule "Wide column sits past the scroll limit"
      if viewport-slack is at most 0
      and column-left is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "Column on the left sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is less than 100 percent of field gap
      and limit-less-left is less than -100 percent of field gap
      then result equals 100 percent of field scroll-limit

    rule "Column on the right sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is at least 100 percent of field gap
      and right-slack is less than 100 percent of field gap
      and limit-less-right is less than 100 percent of field gap
      then result equals 100 percent of field scroll-limit

    rule "Previous offset sits past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is at least 100 percent of field gap
      and right-slack is at least 100 percent of field gap
      and offset is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "No margin, column on the left past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is less than 0
      and column-left is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "No margin, column on the right past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is at least 0
      and right-slack is less than 0
      and limit-less-right is less than 0
      then result equals 100 percent of field scroll-limit

    rule "No margin, previous offset past the scroll limit"
      if viewport-slack is greater than 0
      and viewport-slack is less than 100 percent of field gap
      and left-slack is at least 0
      and right-slack is at least 0
      and offset is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "Margin on the left runs into the start of the ribbon"
      if viewport-slack is greater than 0
      and viewport-slack is at least 100 percent of field gap
      and left-slack is less than 100 percent of field gap
      and column-left is less than 100 percent of field gap
      then result equals 0

    rule "Ribbon no longer than the viewport: nothing to scroll"
      if scroll-limit is at most 0
      then result equals 0

    property "Offset is not negative"
      result is at least 0

    property "Offset is no larger than the ribbon"
      result is at most 100 percent of field ribbon-length

    property "Viewport never starts right of the column"
      result is at most 100 percent of field column-left

    example "Empty ribbon"
      given viewport-width equals 1280
      given column-left equals 0
      given column-width equals 0
      given offset equals 0
      given gap equals 8
      given ribbon-length equals 0
      given viewport-slack equals 1280
      given left-slack equals 0
      given right-slack equals 1280
      given scroll-limit equals -1280
      given overhang equals -1280
      given limit-less-left equals -1280
      given limit-less-right equals 0
      expected result equals 0

    example "One column, ribbon shorter than the viewport"
      given viewport-width equals 1280
      given column-left equals 0
      given column-width equals 636
      given offset equals 0
      given gap equals 8
      given ribbon-length equals 636
      given viewport-slack equals 644
      given left-slack equals 0
      given right-slack equals 644
      given scroll-limit equals -644
      given overhang equals -644
      given limit-less-left equals -644
      given limit-less-right equals 0
      expected result equals 0

    example "Focus on the first column of a long ribbon"
      given viewport-width equals 1280
      given column-left equals 0
      given column-width equals 636
      given offset equals 500
      given gap equals 8
      given ribbon-length equals 3000
      given viewport-slack equals 644
      given left-slack equals -500
      given right-slack equals 1144
      given scroll-limit equals 1720
      given overhang equals -644
      given limit-less-left equals 1720
      given limit-less-right equals 2364
      expected result equals 0

    example "Focus on the last column"
      given viewport-width equals 1280
      given column-left equals 2364
      given column-width equals 636
      given offset equals 0
      given gap equals 8
      given ribbon-length equals 3000
      given viewport-slack equals 644
      given left-slack equals 2364
      given right-slack equals -1720
      given scroll-limit equals 1720
      given overhang equals 1720
      given limit-less-left equals -644
      given limit-less-right equals 0
      expected result equals 1720

    example "Column wider than the viewport"
      given viewport-width equals 1280
      given column-left equals 1000
      given column-width equals 1400
      given offset equals 0
      given gap equals 8
      given ribbon-length equals 3000
      given viewport-slack equals -120
      given left-slack equals 1000
      given right-slack equals -1120
      given scroll-limit equals 1720
      given overhang equals 1120
      given limit-less-left equals 720
      given limit-less-right equals 600
      expected result equals 1000

    example "Column fully visible: the viewport stays"
      given viewport-width equals 1280
      given column-left equals 100
      given column-width equals 600
      given offset equals 50
      given gap equals 8
      given ribbon-length equals 3000
      given viewport-slack equals 680
      given left-slack equals 50
      given right-slack equals 630
      given scroll-limit equals 1720
      given overhang equals -580
      given limit-less-left equals 1620
      given limit-less-right equals 2300
      expected result equals 50

    example "Column narrower than the viewport by less than a gap"
      given viewport-width equals 1280
      given column-left equals 1000
      given column-width equals 1276
      given offset equals 0
      given gap equals 8
      given ribbon-length equals 3000
      given viewport-slack equals 4
      given left-slack equals 1000
      given right-slack equals -996
      given scroll-limit equals 1720
      given overhang equals 996
      given limit-less-left equals 720
      given limit-less-right equals 724
      expected result equals 996

    example "Stale offset after a column closed"
      given viewport-width equals 500
      given column-left equals 600
      given column-width equals 100
      given offset equals 950
      given gap equals 8
      given ribbon-length equals 1000
      given viewport-slack equals 400
      given left-slack equals -350
      given right-slack equals 750
      given scroll-limit equals 500
      given overhang equals 200
      given limit-less-left equals -100
      given limit-less-right equals 300
      expected result equals 500
