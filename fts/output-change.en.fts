// Offset of the ribbon after the viewport changed size under it.
//
// RandR changes the resolution, a monitor is unplugged, a panel takes a
// strip - the ribbon stays as it was and a different window looks at it.
// The only decision here: keep the offset within bounds, and if the ribbon
// is no longer than the viewport, there is nothing to scroll.
//
// The caller computes and passes as a field:
//
//   scroll-limit   ribbon length - viewport width
//
// A negative limit is what "the ribbon is shorter than the viewport" means.


category "Ribbon layout"

  object "Output change"
    viewport-width is number
    offset is number
    ribbon-length is number
    scroll-limit is number

  utility output-change
    accepts "Output change"
    returns number
    starts with 0

    rule "The ribbon is no longer than the viewport"
      if scroll-limit is at most 0
      then result equals 0

    rule "The offset ran past the end of the ribbon"
      if scroll-limit is greater than 0
      and offset is greater than 100 percent of field scroll-limit
      then result equals 100 percent of field scroll-limit

    rule "The offset ran past the start of the ribbon"
      if scroll-limit is greater than 0
      and offset is less than 0
      then result equals 0

    rule "The offset stayed within bounds"
      if scroll-limit is greater than 0
      and offset is at least 0
      and offset is at most 100 percent of field scroll-limit
      then result equals 100 percent of field offset

    property "Offset is not negative"
      result is at least 0

    property "Offset is no larger than the ribbon"
      result is at most 100 percent of field ribbon-length

    example "Empty ribbon"
      given viewport-width equals 1280
      given offset equals 0
      given ribbon-length equals 0
      given scroll-limit equals -1280
      expected result equals 0

    example "Ribbon shorter than the viewport"
      given viewport-width equals 1280
      given offset equals 300
      given ribbon-length equals 900
      given scroll-limit equals -380
      expected result equals 0

    example "The monitor got wider: the offset is past the end"
      given viewport-width equals 1920
      given offset equals 1700
      given ribbon-length equals 3000
      given scroll-limit equals 1080
      expected result equals 1080

    example "The offset stayed within bounds"
      given viewport-width equals 1280
      given offset equals 500
      given ribbon-length equals 3000
      given scroll-limit equals 1720
      expected result equals 500

    example "The offset sits exactly on the limit"
      given viewport-width equals 1280
      given offset equals 1720
      given ribbon-length equals 3000
      given scroll-limit equals 1720
      expected result equals 1720

    example "A negative offset is pulled to the start"
      given viewport-width equals 1280
      given offset equals -10
      given ribbon-length equals 3000
      given scroll-limit equals 1720
      expected result equals 0
