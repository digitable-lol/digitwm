// Width of a column from its preset number.
//
// A preset is a percentage of the viewport.  The gap comes off before the
// multiplication, so two half-width columns and the gap between them add up
// to exactly one viewport.  Full width is the whole viewport, gap and all:
// nothing stands beside such a column anyway.
//
// The percentages are the four numbers that sit in `conf_init()`: 33, 50,
// 67, 100.  The model describes the default set; a set overridden in `cwmrc`
// it does not describe and does not pretend to.
//
// The caller computes the difference:
//
//   inner-width   viewport width - gap
//
// What is not here and why: FTS has no integer division, so "33 percent" is
// an exact fraction while C divides as integers.  The truncation is done by
// the conformance harness, on one named line; see `fts/README.md`.
//
// There is deliberately no "no wider than the viewport" rule: with a
// non-negative gap no preset ever exceeds the viewport, and the rule would
// be dead.  In C it stands for the invariant, not for a case.


category "Ribbon layout"

  object Column
    viewport-width is number
    preset is number
    gap is number
    min-width is number
    inner-width is number

  utility column-width
    accepts Column
    returns number
    starts with 0


    // A number outside the set is pulled to the edge of the set: below zero
    // is the first preset, past the last one is the last.

    rule "A third of the viewport"
      if preset is at most 0
      then result equals 33 percent of field inner-width

    rule "Half the viewport"
      if preset equals 1
      then result equals 50 percent of field inner-width

    rule "Two thirds of the viewport"
      if preset equals 2
      then result equals 67 percent of field inner-width

    rule "The whole viewport"
      if preset is at least 3
      then result equals 100 percent of field viewport-width


    // Below the minimum a column is not squeezed - it simply runs off the
    // edge of the viewport and the ribbon scrolls.

    rule "A third is narrower than the minimum"
      if preset is at most 0
      and min-width is greater than 33 percent of field inner-width
      then result equals 100 percent of field min-width

    rule "Half is narrower than the minimum"
      if preset equals 1
      and min-width is greater than 50 percent of field inner-width
      then result equals 100 percent of field min-width

    rule "Two thirds are narrower than the minimum"
      if preset equals 2
      and min-width is greater than 67 percent of field inner-width
      then result equals 100 percent of field min-width

    rule "The whole viewport is narrower than the minimum"
      if preset is at least 3
      and min-width is greater than 100 percent of field viewport-width
      then result equals 100 percent of field min-width

    property "Width is at least the minimum"
      result is at least 100 percent of field min-width

    // The second property is weaker than one would like: "no wider than the
    // viewport" cannot be written here, because with a viewport narrower
    // than the minimum C deliberately breaks it, and an FTS property knows
    // no conditions.

    property "Width is not negative"
      result is at least 0

    example "A third of the viewport"
      given viewport-width equals 1208
      given preset equals 0
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 396

    example "Half the viewport"
      given viewport-width equals 1208
      given preset equals 1
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 600

    example "Two thirds of the viewport"
      given viewport-width equals 1208
      given preset equals 2
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 804

    example "The whole viewport"
      given viewport-width equals 1208
      given preset equals 3
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 1208

    example "Preset below zero"
      given viewport-width equals 1208
      given preset equals -1
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 396

    example "Preset past the end of the set"
      given viewport-width equals 1208
      given preset equals 7
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1200
      expected result equals 1208


    // Exactly the case the harness truncates for: C answers 419.

    example "A third that does not divide evenly"
      given viewport-width equals 1280
      given preset equals 0
      given gap equals 8
      given min-width equals 120
      given inner-width equals 1272
      expected result equals 419.76000000000005

    example "Narrow viewport: the minimum wins"
      given viewport-width equals 200
      given preset equals 0
      given gap equals 8
      given min-width equals 120
      given inner-width equals 192
      expected result equals 120


    // A viewport narrower than the minimum width: the column comes out
    // wider than the viewport, and that is C's deliberate decision - the
    // minimum outranks the viewport.

    example "Viewport narrower than the minimum"
      given viewport-width equals 100
      given preset equals 3
      given gap equals 8
      given min-width equals 120
      given inner-width equals 92
      expected result equals 120
