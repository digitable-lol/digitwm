// Which column takes focus after a window closed.
//
// `column-count` is how many there were before the close.  `last-column`
// says the closing window lived in the rightmost one.  `only-window` says it
// was alone in its column, that is, the column goes away with it; if not,
// focus stays where it was and there is nothing to work out.
//
// The caller computes and passes as fields:
//
//   columns-left     column count - 1
//   last-remaining   column count - 2
//
// The second is the index of the last of the surviving columns; the model
// needs it because there is no way to subtract one from a field inside a
// condition.


category "Ribbon layout"

  object "Closed window"
    column-index is number
    column-count is number
    last-column is boolean
    only-window is boolean
    columns-left is number
    last-remaining is number

  utility focus-after-close
    accepts "Closed window"
    returns number
    starts with 0

    rule "The column stays where it was"
      if only-window equals false
      then result equals 100 percent of field column-index

    rule "The ribbon is empty now"
      if only-window equals true
      and columns-left is at most 0
      then result equals 0

    rule "The rightmost column went: focus moves left"
      if only-window equals true
      and columns-left is at least 1
      and last-column equals true
      then result equals 100 percent of field last-remaining

    rule "The index fell off the end of the ribbon"
      if only-window equals true
      and columns-left is at least 1
      and last-column equals false
      and column-index is at least 100 percent of field columns-left
      then result equals 100 percent of field last-remaining

    rule "The column on the right takes the place of the one that went"
      if only-window equals true
      and columns-left is at least 1
      and last-column equals false
      and column-index is less than 100 percent of field columns-left
      then result equals 100 percent of field column-index

    property "The column index is not negative"
      result is at least 0

    property "The column index is below the count before the close"
      result is less than 100 percent of field column-count

    example "A window closed but the column stayed"
      given column-index equals 1
      given column-count equals 3
      given last-column equals false
      given only-window equals false
      given columns-left equals 2
      given last-remaining equals 1
      expected result equals 1

    example "The last window of the ribbon closed"
      given column-index equals 0
      given column-count equals 1
      given last-column equals true
      given only-window equals true
      given columns-left equals 0
      given last-remaining equals -1
      expected result equals 0

    example "The rightmost of three columns went"
      given column-index equals 2
      given column-count equals 3
      given last-column equals true
      given only-window equals true
      given columns-left equals 2
      given last-remaining equals 1
      expected result equals 1

    example "The middle column went"
      given column-index equals 1
      given column-count equals 3
      given last-column equals false
      given only-window equals true
      given columns-left equals 2
      given last-remaining equals 1
      expected result equals 1

    example "The first of two columns went"
      given column-index equals 0
      given column-count equals 2
      given last-column equals false
      given only-window equals true
      given columns-left equals 1
      given last-remaining equals 0
      expected result equals 0

    example "The only column, but not its only window"
      given column-index equals 0
      given column-count equals 1
      given last-column equals true
      given only-window equals false
      given columns-left equals 0
      given last-remaining equals -1
      expected result equals 0

    example "The index is past the remaining columns"
      given column-index equals 2
      given column-count equals 3
      given last-column equals false
      given only-window equals true
      given columns-left equals 2
      given last-remaining equals 1
      expected result equals 1
