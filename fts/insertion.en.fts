// Where a window that has just appeared goes.
//
// The answer is a placement code: 0 a fresh column right of the focus, 1
// down the focused column, 2 floating (the ribbon does not take such a
// window), 3 fullscreen.  The numbers are the `RIBBON_PLACE_*` of
// `calmwm.h`.
//
// `config-rule` is the number of the matched `cwmrc` rule: 0 no rule, 1
// stack, 2 float; that is `RIBBON_RULE_*`.  In `layout-probe` the field is
// spelled `rule`, which this surface cannot use for a field: reserved
// English phrases are rewritten by the start of the line, so `rule is
// number` would declare a rule instead of a field.
//
// The conditions of the rules overlap on purpose, and the order decides
// everything here: every rule whose condition holds runs, and the last
// "then result equals" overwrites the ones before it.  So the rules stand in
// increasing precedence - read bottom to top and you get the same order of
// seniority as reading C top to bottom.  A dock that also asks for
// fullscreen stays floating.


category "Ribbon layout"

  object "New window"
    has-focus is boolean
    transient is boolean
    dialog is boolean
    dock is boolean
    fullscreen is boolean
    config-rule is number

  utility insertion
    accepts "New window"
    returns number
    starts with 0

    rule "The configuration rule asks for a stack"
      if config-rule equals 1
      and has-focus equals true
      then result equals 1

    rule "The window asks for fullscreen"
      if fullscreen equals true
      then result equals 3

    rule "A dialog does not join the ribbon"
      if dialog equals true
      then result equals 2

    rule "A transient window does not join the ribbon"
      if transient equals true
      then result equals 2

    rule "A dock does not join the ribbon"
      if dock equals true
      then result equals 2

    rule "The configuration rule asks for floating"
      if config-rule equals 2
      then result equals 2

    property "The placement code is not negative"
      result is at least 0

    property "The placement code is at most three"
      result is at most 3

    example "An ordinary window opens a new column"
      given has-focus equals true
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals false
      given config-rule equals 0
      expected result equals 0

    example "The first window on an empty ribbon"
      given has-focus equals false
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals false
      given config-rule equals 0
      expected result equals 0

    example "The configuration rule puts it in the focused column"
      given has-focus equals true
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals false
      given config-rule equals 1
      expected result equals 1

    example "A stack without focus is impossible"
      given has-focus equals false
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals false
      given config-rule equals 1
      expected result equals 0

    example "A dialog floats"
      given has-focus equals true
      given transient equals false
      given dialog equals true
      given dock equals false
      given fullscreen equals false
      given config-rule equals 0
      expected result equals 2

    example "A transient window floats"
      given has-focus equals true
      given transient equals true
      given dialog equals false
      given dock equals false
      given fullscreen equals false
      given config-rule equals 0
      expected result equals 2

    example "A fullscreen window"
      given has-focus equals true
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals true
      given config-rule equals 0
      expected result equals 3

    example "A dock outranks fullscreen"
      given has-focus equals true
      given transient equals false
      given dialog equals false
      given dock equals true
      given fullscreen equals true
      given config-rule equals 0
      expected result equals 2

    example "The configuration rule outranks everything"
      given has-focus equals true
      given transient equals false
      given dialog equals false
      given dock equals false
      given fullscreen equals true
      given config-rule equals 2
      expected result equals 2
